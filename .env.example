# Auth
NEXTAUTH_SECRET=your_random_secret_here
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# AI — Groq (Free) — required for AI Studio features
GROQ_API_KEY=
# Optional override (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Database — Supabase PostgreSQL
# Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
# DIRECT_URL   = Session / Direct (port 5432) for prisma db push & migrations
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Website traffic — Google Analytics 4
# 1) Add NEXT_PUBLIC_GA_MEASUREMENT_ID to start tracking Calendo page views immediately
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 2) Add these to pull traffic reports into Analytics dashboard (Google Cloud service account)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Email (Optional)
EMAIL_USER=
EMAIL_PASS=
